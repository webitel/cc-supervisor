{
	"name": "@webitel/supervisor",
	"version": "26.8.0",
	"private": true,
	"scripts": {
		"check:libs-train": "node scripts/check-webitel-train.mjs",
		"dev": "vite --force",
		"build": "vite build",
		"preview": "npm run build && vite preview --base /supervisor",
		"test:unit": "vitest",
		"lint:fix": "npx biome check --write ./src",
		"lint:fix-staged": "npx lint-staged",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"utils:i": "npm install --install-links",
		"utils:up-libs": "npm update @webitel/ui-sdk @webitel/ui-datalist @webitel/api-services && npm run utils:ls-libs",
		"utils:link-libs": "npm link @webitel/ui-sdk @webitel/ui-datalist @webitel/api-services && npm run utils:ls-libs",
		"utils:ls-libs": "npm ls @webitel/ui-sdk @webitel/ui-datalist @webitel/api-services",
		"prepare": "husky",
		"biome:ci:gh": "biome ci ./src --reporter=github",
		"test:unit:ci": "vitest run --coverage",
		"typecheck": "vue-tsc --noEmit -p ./tsconfig.json",
		"typecheck:ci": "npm run typecheck"
	},
	"type": "module",
	"dependencies": {
		"@tsconfig/node22": "^22.0.6",
		"@vue/compat": "^3.5.x",
		"@vue/tsconfig": "^0.9.1",
		"@vuelidate/core": "^2.0.3",
		"@vuelidate/validators": "^2.0.4",
		"@webitel/api-services": "~26.8",
		"@webitel/styleguide": "~26.8",
		"@webitel/ui-datalist": "~26.8",
		"@webitel/ui-sdk": "~26.8",
		"axios": "^1.20.0",
		"clipboard-copy": "^4.0.1",
		"deep-copy": "^1.x",
		"deep-equal": "^2.x",
		"deepmerge": "^4.x",
		"lodash-es": "^4.x",
		"pinia": "^3.x",
		"vidstack": "^1.15.6",
		"vue": "^3.5.x",
		"vue-i18n": "^11.x",
		"vue-router": "^4.x",
		"vue-tsc": "^2.2.8",
		"vuex": "^4.1.0",
		"webitel-sdk": "^26.4.31"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@pinia/testing": "^1.0.3",
		"@vitejs/plugin-vue": "^6.x",
		"@vitest/coverage-v8": "^4.x",
		"@vue/test-utils": "^2.5.0",
		"globals": "^17.x",
		"happy-dom": "^20.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.x",
		"prismjs": "^1.29.0",
		"sass": "^1.103.1",
		"tslib": "^2.7.0",
		"typescript": "^5.9.3",
		"vite": "npm:rolldown-vite@^7.3.x",
		"vite-plugin-node-polyfills": "^0.x",
		"vite-plugin-vue-devtools": "^8.x",
		"vite-plugin-vue-docgen": "^0.3.4",
		"vitepress": "^1.x",
		"vitest": "^4.x"
	},
	"optionalDependencies": {
		"@esbuild/darwin-arm64": "^0.28.2",
		"@rollup/rollup-linux-x64-gnu": "^4"
	},
	"overrides": {
		"vite": "npm:rolldown-vite@^7.3.x",
		"@vitejs/plugin-vue": "^6.x"
	}
}
